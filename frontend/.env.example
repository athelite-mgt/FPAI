# Copy to .env.local and fill in. Only VITE_-prefixed variables reach the browser,
# and everything here is public by design — never put a secret in this file.

# Google OAuth client id (the "Web application" client id from Google Cloud Console).
# Leave empty to hide the Google button and use email/password only.
VITE_GOOGLE_CLIENT_ID=

# Microsoft Entra application (client) id, registered as a public client / SPA with
# "Accounts in any organizational directory and personal Microsoft accounts" and a redirect
# URI of <this app's origin>/login. Leave empty to hide the Microsoft button.
VITE_MICROSOFT_CLIENT_ID=

# Where `npm run dev` proxies /api requests. Defaults to http://localhost:5099.
VITE_API_TARGET=http://localhost:5099
